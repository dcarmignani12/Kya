# Copy to .env, or just run `npm run setup` which creates .env and generates the keys.
DATABASE_URL=postgres://agenttrip:agenttrip@localhost:5432/agenttrip
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
# Ed25519 private JWKs (base64url JSON). Generated by `npm run setup`.
AGENT_PRIVATE_KEY=
KYA_PRIVATE_KEY=
PRINCIPAL_PRIVATE_KEY=
